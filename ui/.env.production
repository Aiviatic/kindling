# Build-time PUBLIC config for the browser UI (baked into dist/ui by `vite build`). NOT a secret.
# The opt-in form on the Welcome screen POSTs cross-origin to the Cloudflare Pages Function here
# (the Welcome UI runs on the localhost install server, so this is a full absolute URL, not /opt-in).
# The handler allows loopback origins (functions/_lib/opt-in-core.ts) so the localhost POST is granted.
VITE_OPTIN_ENDPOINT=https://kindling.aiviatic.com/opt-in
